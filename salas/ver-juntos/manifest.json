{
  "manifest_version": 3,
  "name": "Salas de Voz — Ver juntos",
  "short_name": "Ver juntos",
  "version": "1.0.0",
  "description": "Sincroniza Netflix, Disney+, Prime Video, Max, YouTube y más con tus amigos de las Salas de Voz de juegospy.com.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "Ver juntos (Salas de Voz)", "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "48": "icon-48.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://juegospy.com/salas/*", "https://www.juegospy.com/salas/*",
        "https://juegosdemesapy.pages.dev/salas/*", "https://*.juegosdemesapy.pages.dev/salas/*",
        "https://jleov.github.io/juegosdemesapy/salas/*", "http://localhost/juegosdemesapy/salas/*"
      ],
      "js": ["puente.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*", "https://*.disneyplus.com/*",
        "https://www.primevideo.com/*", "https://*.primevideo.com/*", "https://www.amazon.com/*",
        "https://play.max.com/*", "https://*.max.com/*", "https://*.hbomax.com/*",
        "https://www.starplus.com/*", "https://*.paramountplus.com/*",
        "https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*",
        "https://www.youtube.com/*", "https://tv.apple.com/*", "https://www.vix.com/*",
        "https://pluto.tv/*", "https://mubi.com/*", "https://*.mubi.com/*"
      ],
      "js": ["video.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
